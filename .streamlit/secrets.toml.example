# Streamlit Community Cloud: App settings -> Secrets. Paste these lines there
# (not in the repo). With them set, the public URL runs live AI drafting.

# Default: Groq free tier (no card). Key from https://console.groq.com/keys
LLM_PROVIDER = "groq"
GROQ_API_KEY = "REPLACE_WITH_YOUR_GROQ_KEY"

# Alternative free tier: Google Gemini. Key from https://aistudio.google.com/apikey
# LLM_PROVIDER = "gemini"
# GEMINI_API_KEY = "REPLACE_WITH_YOUR_GEMINI_KEY"

# Paid alternative: Claude Haiku 5.5
# LLM_PROVIDER = "anthropic"
# ANTHROPIC_API_KEY = "REPLACE_WITH_YOUR_ANTHROPIC_KEY"
