# Copy to .env and fill in only what you need. The core demo runs with NONE of these set.

# --- LLM (optional) -----------------------------------------------------------
# mock      deterministic generator, no AI (tests and offline backup only)
# ollama    local model on 127.0.0.1, nothing leaves the machine (needs `ollama pull gemma3`)
# groq      FREE tier, gpt-oss-20b; what the hosted demo uses (key: console.groq.com/keys)
# gemini    FREE tier, Gemini 2.5 Flash (key: aistudio.google.com/apikey)
# anthropic Claude Haiku 5.5 (paid)
# litellm   any provider LiteLLM supports (pip install litellm)
LLM_PROVIDER=mock
# LLM_MODEL defaults per provider; override only if you know you need to.
# LLM_MODEL=
# REPLACE WITH YOUR KEY for the provider you chose. Never commit it.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Embeddings (optional) --------------------------------------------------
EMBEDDINGS_BACKEND=tfidf          # tfidf | sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store (optional) ----------------------------------------------
VECTORSTORE_BACKEND=local         # local (numpy, persisted) | chroma
CHROMA_PATH=.chroma

# --- Web enrichment (secondary, optional) --------------------------------
WEB_SEARCH_PROVIDER=mock          # mock | tavily | ddg
WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY=

# --- Verifier thresholds (set by Phase 0 calibration, scripts/calibrate.py) --
SEM_SUPPORTED=0.42
SEM_PARTIAL=0.22
LEX_SUPPORTED=0.18

# --- Storage --------------------------------------------------------------
DB_PATH=.data/proposal_copilot.sqlite
